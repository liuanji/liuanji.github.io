[Unit]
Description=Lightweight local GPU monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=servermonitor
Group=servermonitor
WorkingDirectory=/opt/servermonitor
ExecStart=/usr/bin/python3 -m servermonitor serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/servermonitor/data

[Install]
WantedBy=multi-user.target
